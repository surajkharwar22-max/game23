{"id":1,"name":"Opening Cutscene","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":231,"indent":0,"parameters":[1,"Intro/1",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina was never one to follow the expected path."]},{"code":401,"indent":0,"parameters":["Born in a quiet village, her days were spent dreaming of "]},{"code":401,"indent":0,"parameters":["legends and lost worlds."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Tales of Morrak — the shadowed god of forgotten realms —"]},{"code":401,"indent":0,"parameters":["fascinated her since childhood."]},{"code":357,"indent":0,"parameters":["DK_Video_Player","LoadVideo","Load Video",{"layer":"1","src":"Celina Searching Cave"}]},{"code":657,"indent":0,"parameters":["Layer = 1"]},{"code":657,"indent":0,"parameters":["Video source = Celina Searching Cave"]},{"code":357,"indent":0,"parameters":["DK_Video_Player","PlayVideo","Play Video",{"layer":"1","loop":"true","wait":"false"}]},{"code":657,"indent":0,"parameters":["Layer = 1"]},{"code":657,"indent":0,"parameters":["Loop = true"]},{"code":657,"indent":0,"parameters":["Wait = false"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["When ancient scrolls surfaced, hinting at Morrak’s burial "]},{"code":401,"indent":0,"parameters":["site hidden deep within the Whispering Mountains, Celina "]},{"code":401,"indent":0,"parameters":["knew this was her chance — to step beyond the mundane and "]},{"code":401,"indent":0,"parameters":["uncover truths long buried in darkness."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Armed with nothing but courage and a heart full of "]},{"code":401,"indent":0,"parameters":["questions, she set out alone, driven by a yearning she "]},{"code":401,"indent":0,"parameters":["couldn’t name."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Her quest led her to the mountain’s highest reaches."]},{"code":401,"indent":0,"parameters":["With resolve in her heart, she searched relentlessly."]},{"code":230,"indent":0,"parameters":[60]},{"code":102,"indent":0,"parameters":[["Continue?"],-1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Continue?"]},{"code":357,"indent":1,"parameters":["DK_Video_Player","StopVideo","Stop video",{"layer":"1"}]},{"code":657,"indent":1,"parameters":["Layer = 1"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[120]},{"code":241,"indent":0,"parameters":[{"name":"_DarkAmbient","volume":50,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[120]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["As dusk settled, she stumbled upon an entrance hidden on "]},{"code":401,"indent":0,"parameters":["the backside of the mountain — the gateway to an adventure "]},{"code":401,"indent":0,"parameters":["that would change her world forever."]},{"code":231,"indent":0,"parameters":[1,"Intro/2",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["This must be it... The entrance to Morrak’s "]},{"code":401,"indent":0,"parameters":["tomb. It doesn’t look like much, but... "]},{"code":401,"indent":0,"parameters":["something about it feels alive."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["... "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Am I really ready for this?"]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Intro/3",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Near the entrance, Celina stumbles upon a face "]},{"code":401,"indent":0,"parameters":["carved in the cave wall. She moves in to inspect."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["This face..."]},{"code":401,"indent":0,"parameters":["Did someone really carve this into the wall?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["The rock is so smooth... "]},{"code":401,"indent":0,"parameters":["The details in the face..."]},{"code":401,"indent":0,"parameters":["It would take a master sculptor to work "]},{"code":401,"indent":0,"parameters":["the stone like this. "]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina continues down a winding, weaving path deep"]},{"code":401,"indent":0,"parameters":["into the mountainside. "]},{"code":231,"indent":0,"parameters":[1,"Intro/4",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["A tunnel... I wonder where it leads."]},{"code":401,"indent":0,"parameters":["It goes deeper than it should."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["The air’s colder here... "]},{"code":401,"indent":0,"parameters":["And there's a strange odor..."]},{"code":401,"indent":0,"parameters":["Is something alive down here?"]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["At the end of the tunnel, Celina finds "]},{"code":401,"indent":0,"parameters":["herself in a strange room with stone eyes"]},{"code":401,"indent":0,"parameters":["peering back at her."]},{"code":231,"indent":0,"parameters":[1,"Intro/5",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["These statues are incredible! "]},{"code":401,"indent":0,"parameters":["They don't look human. It's as if"]},{"code":401,"indent":0,"parameters":["they're staring at me."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Here, on the wall. This is burial iconography. "]},{"code":401,"indent":0,"parameters":["Ancient, but it's all here..."]},{"code":401,"indent":0,"parameters":["This must be the place!"]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Intro/6",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The pathway becomes narrower and the ceiling shorter, "]},{"code":401,"indent":0,"parameters":["Celina must crouch to maneuver the labyrinth she's "]},{"code":401,"indent":0,"parameters":["found herself in. "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["That feeling again..."]},{"code":401,"indent":0,"parameters":["Like something’s watching me. No... calling me."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["It wants me to come closer."]},{"code":401,"indent":0,"parameters":["Something here longs for me..."]},{"code":401,"indent":0,"parameters":["Like it’s been waiting."]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Intro/7",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Another grand room with towering statues and... "]},{"code":401,"indent":0,"parameters":["Lit candles? "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Such strange art. "]},{"code":401,"indent":0,"parameters":["This one in the middle... "]},{"code":401,"indent":0,"parameters":["Is he a leader? Or maybe a figure of worship."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["And these ones behind..."]},{"code":401,"indent":0,"parameters":["No inscriptions. No names."]},{"code":401,"indent":0,"parameters":["I get the feeling this is more than just art. "]},{"code":401,"indent":0,"parameters":["Could this place also be a temple?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["And who lit these candles? Is someone else "]},{"code":401,"indent":0,"parameters":["down here with me? "]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Intro/8",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina continued on. The air grew still and cold"]},{"code":401,"indent":0,"parameters":["began to claw at her. "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["How far do these tunnels go? Its getting..."]},{"code":401,"indent":0,"parameters":["Hard to focus. Hard to breathe. "]},{"code":401,"indent":0,"parameters":["But I can't turn back now, I feel..."]},{"code":401,"indent":0,"parameters":["Drawn to keep going. "]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Intro/9",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The passage opens into a cavernous chamber, "]},{"code":401,"indent":0,"parameters":["swallowed by darkness. In the shadows, Celina  can make"]},{"code":401,"indent":0,"parameters":["out the shape of strange creatures with sharp teeth."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["What are those creatures? Such sharp teeth."]},{"code":401,"indent":0,"parameters":["Strange sculptures..."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["At least that is what she thought. Out of the corner of her"]},{"code":401,"indent":0,"parameters":["eye she could have sworn she saw one moving. She squints"]},{"code":401,"indent":0,"parameters":["to clear her vision..."]},{"code":235,"indent":0,"parameters":[1]},{"code":261,"indent":0,"parameters":["Jokers Cry"]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["No... this isn’t right. My eyes are playing"]},{"code":401,"indent":0,"parameters":["tricks on me. I... I need to get out of here!"]},{"code":357,"indent":0,"parameters":["DK_Video_Player","LoadVideo","Load Video",{"layer":"1","src":"ScaredEscape"}]},{"code":657,"indent":0,"parameters":["Layer = 1"]},{"code":657,"indent":0,"parameters":["Video source = ScaredEscape"]},{"code":357,"indent":0,"parameters":["DK_Video_Player","PlayVideo","Play Video",{"layer":"1","loop":"true","wait":"false"}]},{"code":657,"indent":0,"parameters":["Layer = 1"]},{"code":657,"indent":0,"parameters":["Loop = true"]},{"code":657,"indent":0,"parameters":["Wait = false"]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina runs back to where she came trying to retrace her "]},{"code":401,"indent":0,"parameters":["steps, but the way back feels "]},{"code":401,"indent":0,"parameters":["different — shadows shifting, passages twisting "]},{"code":401,"indent":0,"parameters":["unnaturally. "]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Is she being chased? She thinks she hears footsteps "]},{"code":401,"indent":0,"parameters":["behind her. Her heart is racing, she stumbles through the"]},{"code":401,"indent":0,"parameters":["maze, unsure where she's at."]},{"code":230,"indent":0,"parameters":[60]},{"code":102,"indent":0,"parameters":[["Continue?"],-1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Continue?"]},{"code":221,"indent":1,"parameters":[]},{"code":357,"indent":1,"parameters":["DK_Video_Player","StopVideo","Stop video",{"layer":"1"}]},{"code":657,"indent":1,"parameters":["Layer = 1"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Intro/10",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She happens upon a room unlike any before. "]},{"code":401,"indent":0,"parameters":["At its center stands a circular stone "]},{"code":401,"indent":0,"parameters":["structure, glowing faintly with an otherworldly light."]},{"code":401,"indent":0,"parameters":["She looks back to see if she has been followed..."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["But she sees nothing. She seems to be alone, "]},{"code":401,"indent":0,"parameters":["for now at least. "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celia"]},{"code":401,"indent":0,"parameters":["What is this place?"]},{"code":401,"indent":0,"parameters":["It’s calling me... I can feel it."]},{"code":401,"indent":0,"parameters":["I don’t know if I should trust it... "]},{"code":401,"indent":0,"parameters":["but I can’t turn away."]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Intro/11",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina stepped cautiously into the chamber, The room was "]},{"code":401,"indent":0,"parameters":["silent and utterly still — except for the flickering of "]},{"code":401,"indent":0,"parameters":["dozens of tall, wax-dripping candles"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["They stood in deliberate lines, arranged like sentinels, "]},{"code":401,"indent":0,"parameters":["all pointed inward toward a singular object of attention: "]},{"code":401,"indent":0,"parameters":["the enormous stone face at the center of the room."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The face was grotesquely large, its eyes sunken and empty, "]},{"code":401,"indent":0,"parameters":["and its mouth stretched into a disturbingly wide smile. "]},{"code":401,"indent":0,"parameters":["Not a joyful smile — something deeper, wrong, as though "]},{"code":401,"indent":0,"parameters":["it delighted in secrets Celina was never meant to know. "]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Eventually, a low voice rang out through the silence..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Voice"]},{"code":401,"indent":0,"parameters":["Carved in jest, crowned in lies,"]},{"code":401,"indent":0,"parameters":["A hunger laughs beneath the stone."]},{"code":401,"indent":0,"parameters":["I grin where gods meet their demise,"]},{"code":401,"indent":0,"parameters":["And feast upon the light you own."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Voice"]},{"code":401,"indent":0,"parameters":["Seek the fool who speaks in riddles,"]},{"code":401,"indent":0,"parameters":["Whose tongue is twisted, sly, and fleet."]},{"code":401,"indent":0,"parameters":["My ancient rival guards the middles —"]},{"code":401,"indent":0,"parameters":["A truth both sharp and bittersweet."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Voice"]},{"code":401,"indent":0,"parameters":["Paint your lips, my lovely snare,"]},{"code":401,"indent":0,"parameters":["And dance him close with sugared lies."]},{"code":401,"indent":0,"parameters":["He’ll chase the smile, unaware,"]},{"code":401,"indent":0,"parameters":["Then loose the charm that seals his life."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Voice"]},{"code":401,"indent":0,"parameters":["May shadow dance again."]},{"code":242,"indent":0,"parameters":[2]},{"code":230,"indent":0,"parameters":[120]},{"code":235,"indent":0,"parameters":[1]},{"code":261,"indent":0,"parameters":["Morrak Intro"]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[240]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina lies motionless on the muddy ground, "]},{"code":401,"indent":0,"parameters":["her skin pale against the dark soil. Her hair "]},{"code":401,"indent":0,"parameters":["is tangled, soaked, clinging to her face and "]},{"code":401,"indent":0,"parameters":["shoulders. "]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She is completely nude — exposed, "]},{"code":401,"indent":0,"parameters":["vulnerable, and disoriented."]},{"code":201,"indent":0,"parameters":[0,1,5,76,2,0]},{"code":211,"indent":0,"parameters":[1]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
