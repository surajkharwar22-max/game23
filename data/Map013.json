{"id":1,"name":"Serith","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":109,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Serith Walking","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":223,"indent":0,"parameters":[[-255,-255,-255,0],60,true]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The workshop smelled of strange herbs and heated metal, the "]},{"code":401,"indent":0,"parameters":["scent clinging to the stone walls like an old secret. "]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Flickering lanternlight cast long shadows across shelves "]},{"code":401,"indent":0,"parameters":["cluttered with alchemical instruments—stoppered vials "]},{"code":401,"indent":0,"parameters":["filled with glimmering liquids, racks of dried roots, and "]},{"code":401,"indent":0,"parameters":["brittle scrolls curling with age."]},{"code":231,"indent":0,"parameters":[1,"Act 2/1",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Serith stood wearing his usual half-torn robe, its hem "]},{"code":401,"indent":0,"parameters":["stained by years of failed experiments. His gray eyes "]},{"code":401,"indent":0,"parameters":["burned with a quiet urgency as he poured the mixture into a "]},{"code":401,"indent":0,"parameters":["flask that pulsed with faint light, sealing it with a cork."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["You have it?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["All of it. Every coin you asked for."]},{"code":125,"indent":0,"parameters":[1,0,100]},{"code":250,"indent":0,"parameters":[{"name":"Coin","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Good. This will keep us moving forward... "]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Act 2/2",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["You said yesterday there was something else "]},{"code":401,"indent":0,"parameters":["I needed to do. About an artifact..."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Yes. We need an artifact that’s in the mayor’s "]},{"code":401,"indent":0,"parameters":["possession."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["I told you before—it’s likely embedded into "]},{"code":401,"indent":0,"parameters":["the house itself, not something he’ll simply "]},{"code":401,"indent":0,"parameters":["leave lying around. That’s why we need you "]},{"code":401,"indent":0,"parameters":["inside."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Inside... his house?"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Exactly. The man is Gideon Thorne. The mayor. "]},{"code":401,"indent":0,"parameters":["Suspicious bastard—doesn’t trust anyone. But "]},{"code":401,"indent":0,"parameters":["he needs a maid, and you’ll make sure you get "]},{"code":401,"indent":0,"parameters":["the job. There won’t be another chance."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["...And how do I make sure I get the job?"]},{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Serith moves to a nearby shelf, selecting a tall, narrow "]},{"code":401,"indent":0,"parameters":["glass. From a black bottle etched with runes, he pours a "]},{"code":401,"indent":0,"parameters":["green liquid that gleams like molten emerald under the "]},{"code":401,"indent":0,"parameters":["candlelight."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He offers it to Celina, the swirling contents seeming "]},{"code":401,"indent":0,"parameters":["almost alive in his steady hand."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["With this."]},{"code":231,"indent":0,"parameters":[1,"Act 2/3",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["...What is it?"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Insurance. Nothing harmful—just a little "]},{"code":401,"indent":0,"parameters":["magic to make sure Gideon finds you..."]},{"code":401,"indent":0,"parameters":["persuasive."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["...And if I don’t drink it?"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Then you’re leaving your future to chance, "]},{"code":401,"indent":0,"parameters":["Celina."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina’s throat tightens. She feels the weight of his "]},{"code":401,"indent":0,"parameters":["words press down on her chest. For a long moment, she "]},{"code":401,"indent":0,"parameters":["doesn’t move."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["However, drawn by curiosity, she lifts the glass and "]},{"code":401,"indent":0,"parameters":["swallows the emerald liquid in one smooth motion."]},{"code":357,"indent":0,"parameters":["DK_Video_Player","LoadVideo","Load Video",{"layer":"1","src":"Serth 1 Drink"}]},{"code":657,"indent":0,"parameters":["Layer = 1"]},{"code":657,"indent":0,"parameters":["Video source = Serth 1 Drink"]},{"code":357,"indent":0,"parameters":["DK_Video_Player","PlayVideo","Play Video",{"layer":"1","loop":"true","wait":"false"}]},{"code":657,"indent":0,"parameters":["Layer = 1"]},{"code":657,"indent":0,"parameters":["Loop = true"]},{"code":657,"indent":0,"parameters":["Wait = false"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["As the liquid slides down her throat, Serith’s lips curl "]},{"code":401,"indent":0,"parameters":["into a satisfied grin, eyes glinting with anticipation."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Good... all according to plan."]},{"code":230,"indent":0,"parameters":[60]},{"code":102,"indent":0,"parameters":[["Continue?"],-1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Continue?"]},{"code":221,"indent":1,"parameters":[]},{"code":357,"indent":1,"parameters":["DK_Video_Player","StopVideo","Stop video",{"layer":"1"}]},{"code":657,"indent":1,"parameters":["Layer = 1"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":242,"indent":0,"parameters":[5]},{"code":230,"indent":0,"parameters":[360]},{"code":241,"indent":0,"parameters":[{"name":"_ChillSexy","volume":10,"pitch":100,"pan":0}]},{"code":231,"indent":0,"parameters":[1,"Act 2/4",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Almost immediately, Celina feels the potion’s