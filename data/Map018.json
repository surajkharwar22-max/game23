{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":121,"indent":0,"parameters":[146,146,0]},{"code":231,"indent":0,"parameters":[1,"Act 2/122",0,0,0,0,100,100,255,0]},{"code":223,"indent":0,"parameters":[[-255,-255,-255,0],60,true]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina steps into the dim, concrete chamber beneath the "]},{"code":401,"indent":0,"parameters":["sanctum. The air is cool and stale, the only sounds the "]},{"code":401,"indent":0,"parameters":["faint drip of water somewhere in the dark."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Old barrels and storage crates are stacked in the corners, "]},{"code":401,"indent":0,"parameters":["half-forgotten and gathering dust."]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Act 2/123",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["At the center of the room is a heavy wooden table—sturdy, "]},{"code":401,"indent":0,"parameters":["plain, and out of place among the stone."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Resting on top of it is a square wooden pedestal, carved "]},{"code":401,"indent":0,"parameters":["with subtle grooves and a shallow depression shaped "]},{"code":401,"indent":0,"parameters":["perfectly for the orb she carries."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina hesitates only a moment before lifting the orb from "]},{"code":401,"indent":0,"parameters":["her hands. Its faint warmth pulses against her palms as "]},{"code":401,"indent":0,"parameters":["she sets it onto the square pedestal."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The fit is perfect—too perfect—slotting into the carved "]},{"code":401,"indent":0,"parameters":["recess with a soft wooden click."]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Act 2/124",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina lowers herself to the cold concrete floor beside "]},{"code":401,"indent":0,"parameters":["Liam, who’s sitting against the wall looking small and "]},{"code":401,"indent":0,"parameters":["exhausted in the dim light."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["I know it isn’t much... but it’s only "]},{"code":401,"indent":0,"parameters":["temporary. Just for a little while, okay?"]},{"code":101,"indent":0,"parameters":["Liam Headshot",0,0,2,"Liam"]},{"code":401,"indent":0,"parameters":["You promise?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["I promise. Try to get some sleep. I’ll be "]},{"code":401,"indent":0,"parameters":["right next door. If you need anything, call "]},{"code":401,"indent":0,"parameters":["for me."]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Act 2/125",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Liam settles onto the small hay-stuffed bed in the corner, "]},{"code":401,"indent":0,"parameters":["the straw rustling beneath him. A thin blanket lies "]},{"code":401,"indent":0,"parameters":["folded at the foot; Celina pulls it over him gently."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["He relaxes a little as she smooths the creases and tucks "]},{"code":401,"indent":0,"parameters":["the edges around him."]},{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,18,10,3,2,0]},{"code":235,"indent":0,"parameters":[1]},{"code":223,"indent":0,"parameters":[[-68,-68,0,68],60,true]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":145,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":11,"y":7},
