rameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina descends to the basement, the faint glow of "]},{"code":401,"indent":0,"parameters":["lanterns casting long shadows over the hay-strewn floor. "]},{"code":401,"indent":0,"parameters":["Liam lies curled in his small bed of hay, still half-asleep. "]},{"code":401,"indent":0,"parameters":["She kneels beside him and gently shakes his shoulder."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Liam... wake up. I need to tell you something."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["I have to go away for a little while. "]},{"code":401,"indent":0,"parameters":["There’s... one final task I need to finish "]},{"code":401,"indent":0,"parameters":["before we can put all of this behind us."]},{"code":101,"indent":0,"parameters":["Liam Headshot",0,0,2,"Liam"]},{"code":401,"indent":0,"parameters":["...What? I don’t want you to go..."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["I’ll be back, Liam. Don’t worry. Just... keep "]},{"code":401,"indent":0,"parameters":["an eye on Serith for me, alright? If he does "]},{"code":401,"indent":0,"parameters":["anything wrong, you be sure to tell me when "]},{"code":401,"indent":0,"parameters":["I get back."]},{"code":101,"indent":0,"parameters":["Liam Headshot",0,0,2,"Liam"]},{"code":401,"indent":0,"parameters":["I’ll be careful... I promise."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina presses a hand to his head briefly, then stands, "]},{"code":401,"indent":0,"parameters":["steeling herself for the task ahead."]},{"code":221,"indent":0,"parameters":[]},{"code":121,"indent":0,"parameters":[150,150,0]},{"code":235,"indent":0,"parameters":[1]},{"code":222,"indent":0,"parameters":[]},