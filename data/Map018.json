{"id":5,"name":"Sanctum Sleep","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":121,"indent":0,"parameters":[145,145,0]},{"code":231,"indent":0,"parameters":[1,"Act 2/126",0,0,0,0,100,100,255,0]},{"code":223,"indent":0,"parameters":[[-255,-255,-255,0],60,true]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina steps out and quietly pulls the door closed. A short "]},{"code":401,"indent":0,"parameters":["hallway leads to her own room — a stark concrete chamber "]},{"code":401,"indent":0,"parameters":["with a wooden bed pushed against one wall and an old "]},{"code":401,"indent":0,"parameters":["dresser beside it."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She sets her belongings inside the dresser, then undresses, "]},{"code":401,"indent":0,"parameters":["folding her clothes neatly. The cold air brushes her bare "]},{"code":401,"indent":0,"parameters":["skin as she slips under her blanket, settling in for the "]},{"code":401,"indent":0,"parameters":["night."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Lying on her back in the cold stillness of the room, she "]},{"code":401,"indent":0,"parameters":["stares up at the ceiling, unable to quiet her thoughts."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The day plays back in jagged fragments — seducing Gideon, "]},{"code":401,"indent":0,"parameters":["stealing the artifact, the panic in the tunnels, the way "]},{"code":401,"inden