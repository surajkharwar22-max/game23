{"id":1,"name":"Serith","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Serith Walking","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":121,"indent":0,"parameters":[15,15,0]},{"code":231,"indent":0,"parameters":[1,"Act 1/9",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Excuse me... are you Serith?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["The dark mage was deep in his books and sorcery. Untold "]},{"code":401,"indent":0,"parameters":["mysteries in the form of bottles and potions lined the "]},{"code":401,"indent":0,"parameters":["walls. He didn't turn his head to acknowledge her presence. "]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Hm, yes. And who's asking?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["My name is Celina, I was told to seek you out"]},{"code":401,"indent":0,"parameters":["by a man I met the woods. He said his name "]},{"code":401,"indent":0,"parameters":["was Orun..."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["You've seen Orun?"]},{"code":231,"indent":0,"parameters":[1,"Act 1/10",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["At the mention of Orun, the man's interest was peaked. "]},{"code":401,"indent":0,"parameters":["He straightned himself out and turned to face Celina."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["What a beauty you are - perhaps you did see"]},{"code":401,"indent":0,"parameters":["Orun. His weakness was always the flesh. And"]},{"code":401,"indent":0,"parameters":["what fine flesh you have... "]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina winced at that last remark. The man's gaze felt "]},{"code":401,"indent":0,"parameters":["like fingers under her skin. "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Y... yes, it was last night in fact. "]},{"code":401,"indent":0,"parameters":["In the woods, not far from here. "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["I have... a strange story of how I got here."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina told Serith her tale - of meeting the mysterious"]},{"code":401,"indent":0,"parameters":["man in the woods and of the ruins and of the face of "]},{"code":401,"indent":0,"parameters":["Morrak that still haunts her. She even told him of her "]},{"code":401,"indent":0,"parameters":["enounter with Skel, the beast from her most recent dreams. "]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["So you've encountered Morrak you say..."]},{"code":401,"indent":0,"parameters":["How... Interesting..."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["What is it?"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["I don't know fully, perhaps a coincidence?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Please, tell me what you know!"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["The truth is, I haven't seen Orun in years. "]},{"code":401,"indent":0,"parameters":["Its true this is his sanctum, but he's been on "]},{"code":401,"indent":0,"parameters":["the run. I know not what from, but he was "]},{"code":401,"indent":0,"parameters":["getting close to dangerous secrets. "]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Perhaps those secrets led him to Morrak -"]},{"code":401,"indent":0,"parameters":["not so different from you I'd say. "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["You haven't seen him in years!? Who knows "]},{"code":401,"indent":0,"parameters":["how long it will be until he returns then!"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Yes, exactly... But if you really want to "]},{"code":401,"indent":0,"parameters":["see where this trail will lead you, then we'll "]},{"code":401,"indent":0,"parameters":["need supplies. Powerful supplies. It will"]},{"code":401,"indent":0,"parameters":["take a great deal to entice Orun. "]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["You really think you can get him to return?"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["With your help, yes. But are you sure you want "]},{"code":401,"indent":0,"parameters":["to go down this path? Magic is a strange "]},{"code":401,"indent":0,"parameters":["mistress, she will take more from you than "]},{"code":401,"indent":0,"parameters":["you expect."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["I don't have any other options, I just "]},{"code":401,"indent":0,"parameters":["want to find a way to get home. It sounds like"]},{"code":401,"indent":0,"parameters":["all paths lead to Orun. I must speak to him!"]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Very well. I will need some time to prepare."]},{"code":401,"indent":0,"parameters":["We will also need some gold for the supplies."]},{"code":401,"indent":0,"parameters":["How much do you have?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Um... None. How much do we need? I guess"]},{"code":401,"indent":0,"parameters":["I could work at the tavern to earn some."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["We will need at least 100 gold pieces - it "]},{"code":401,"indent":0,"parameters":["wont take me long to collect what I need once"]},{"code":401,"indent":0,"parameters":["I have it. Return to me when you're ready."]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["I will Serith. And... Thank you."]},{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["By the end, sweet one, gratitude will be the "]},{"code":401,"indent":0,"parameters":["last thing on your lips — a curse may come "]},{"code":401,"indent":0,"parameters":["easier."]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Celina contemplated inquiring about what the dark mage"]},{"code":401,"indent":0,"parameters":["meant - but decided otherwise."]},{"code":222,"indent":0,"parameters":[]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":16,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":16,"indent":null}]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["Time to go talk to Henry - I guess I will"]},{"code":401,"indent":0,"parameters":["need that job after all. Being a barmaid "]},{"code":401,"indent":0,"parameters":["shouldn't be too tough!"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["...Right?..."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":15,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Serith Walking","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["..."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":37,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Serith Walking","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Serith Headshot",0,0,2,"Serith"]},{"code":401,"indent":0,"parameters":["Are you ready Celina? Do you have the gold?"]},{"code":101,"indent":0,"parameters":["Celina Headshot",0,0,2,"Celina"]},{"code":401,"indent":0,"parameters":["No, not yet."